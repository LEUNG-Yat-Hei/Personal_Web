---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { site } from "../../data";
import Layout from "../../layouts/Layout.astro";
import { href } from "../../lib/asset";
import { formatPostDate, getPublishedPosts, postHref, readingTime } from "../../lib/blog";

const heading = site.nav.find((item) => item.id === "dispatches");
const posts = await getPublishedPosts();
---

<Layout
  title={`Dispatches — ${site.meta.title}`}
  description="Notes from the desk. Markdown columns filed in The Ledger."
>
  <SiteHeader />
  <main id="main">
    <section class="scroll-mt-24 newsprint-texture border-b border-ink">
      <div class="mx-auto max-w-screen-xl px-4 py-16">
        <header class="mb-8 border-b-4 border-ink pb-4">
          <p class="font-mono text-xs tracking-widest text-accent uppercase">The Ledger</p>
          <h1 class="mt-3 font-serif text-4xl font-black text-ink lg:text-5xl">
            {heading?.label ?? "Dispatches"}
          </h1>
          <p class="mt-2 font-sans text-sm tracking-wide text-secondary italic">
            {heading?.prompt ?? "Notes from the desk"}
          </p>
        </header>

        {
          posts.length === 0 ? (
            <p class="border border-ink bg-paper px-6 py-10 text-center text-secondary">
              No dispatches on file. Add a Markdown file to{" "}
              <code class="font-mono text-sm text-ink">src/content/blog/</code>.
            </p>
          ) : (
            <ol class="border-t border-ink">
              {posts.map((post, index) => (
                <li class="border-b border-ink py-8 last:border-b-0">
                  <article>
                    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
                      <div class="lg:col-span-3">
                        <p class="font-mono text-xs tracking-widest text-accent uppercase">
                          Column {String(index + 1).padStart(2, "0")}
                        </p>
                        <p class="mt-2 font-mono text-[11px] tracking-widest text-caption uppercase">
                          {formatPostDate(post.data.pubDate)}
                        </p>
                        <p class="mt-1 font-mono text-[11px] tracking-widest text-caption uppercase">
                          {readingTime(post.body)}
                          {post.data.draft && " · Desk copy"}
                        </p>
                      </div>
                      <div class="lg:col-span-9 lg:pr-4">
                        {post.data.kicker && (
                          <p class="font-mono text-xs tracking-widest text-accent uppercase">
                            {post.data.kicker}
                          </p>
                        )}
                        <h2 class="mt-2 font-serif text-2xl font-bold text-ink lg:text-3xl">
                          <a
                            href={postHref(post)}
                            class="underline-offset-4 decoration-2 decoration-accent hover:underline"
                          >
                            {post.data.title}
                          </a>
                        </h2>
                        <p class="mt-3 text-justify text-base leading-relaxed text-secondary">
                          {post.data.description}
                        </p>
                        {post.data.tags.length > 0 && (
                          <ul class="mt-4 flex flex-wrap gap-2">
                            {post.data.tags.map((tag) => (
                              <li class="border border-ink px-2 py-1 font-mono text-[11px] tracking-widest uppercase">
                                {tag}
                              </li>
                            ))}
                          </ul>
                        )}
                        <p class="mt-5">
                          <a
                            href={postHref(post)}
                            class="font-sans text-xs font-semibold tracking-widest uppercase underline-offset-4 decoration-2 decoration-accent hover:underline"
                          >
                            Read dispatch
                          </a>
                        </p>
                      </div>
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          )
        }

        <p class="mt-10 font-mono text-[11px] tracking-widest text-caption uppercase">
          <a href={href("/")} class="hover:text-accent">Return to the front page</a>
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
