---
import { site } from "../data";
import { asset } from "../lib/asset";
import Button from "./Button.astro";

const { profile } = site;
---

<section id="init" class="scroll-mt-24 newsprint-texture border-b border-ink">
  <div class="mx-auto max-w-screen-xl px-4 py-16">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">
      Breaking
    </p>
    <h1
      class="mt-3 font-serif text-5xl leading-[0.9] font-normal tracking-tighter text-ink sm:text-6xl lg:text-9xl"
    >
      {profile.name.display}
    </h1>
    <p class="mt-6 font-sans text-sm tracking-widest text-secondary uppercase">
      {profile.title} · {profile.location}
    </p>
    <p class="mt-4 font-serif text-xl text-secondary italic lg:text-2xl">
      {profile.tagline}
    </p>
    <p class="drop-cap mt-8 text-justify text-base leading-relaxed lg:text-lg">
      {profile.summary}
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href={asset(profile.resume.href)} class="w-full sm:w-auto">
        {profile.resume.label}
      </Button>
      <Button href="#uplink" variant="secondary" class="w-full sm:w-auto">
        Letters
      </Button>
    </div>
  </div>
</section>
