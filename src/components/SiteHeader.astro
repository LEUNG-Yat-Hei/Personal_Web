---
import { site } from "../data";
import { asset, href } from "../lib/asset";
import Button from "./Button.astro";

const { profile, nav } = site;
const edition = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date());
const path = Astro.url.pathname.replace(/\/$/, "");

function itemIsCurrent(itemHref: string): boolean {
  if (itemHref.startsWith("#")) return false;
  const target = href(itemHref).replace(/\/$/, "");
  return path === target || path.startsWith(`${target}/`);
}
---

<header class="sticky top-0 z-40 border-b border-ink bg-paper">
  <div class="mx-auto max-w-screen-xl px-4">
    <div class="hidden items-center justify-between border-b border-ink py-2 font-mono text-[11px] tracking-widest uppercase md:flex">
      <p>Vol. I</p>
      <p>{edition}</p>
      <p>{profile.location} Edition</p>
    </div>

    <div class="flex items-center justify-between gap-4 py-3">
      <a href={href("/")} class="min-h-11 font-serif text-xl font-normal tracking-tight text-ink italic sm:text-2xl">
        The Ledger
      </a>

      <nav class="hidden items-center lg:flex" aria-label="Primary">
        {
          nav.map((item) => (
            <a
              href={href(item.href)}
              aria-current={itemIsCurrent(item.href) ? "page" : undefined}
              class:list={[
                "min-h-11 px-2 py-2 font-sans text-xs tracking-widest uppercase transition-colors duration-200 hover:text-accent xl:px-3",
                itemIsCurrent(item.href) ? "text-accent" : "text-ink",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <Button href={asset(profile.resume.href)} variant="secondary" class="hidden sm:inline-flex">
          {profile.resume.label}
        </Button>
        <details class="relative lg:hidden">
          <summary
            class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center border border-ink px-3 font-sans text-xs tracking-widest uppercase"
            aria-label="Open menu"
          >
            Menu
          </summary>
          <div class="absolute right-0 z-50 mt-1 w-56 border border-ink bg-paper">
            {
              nav.map((item) => (
                <a
                  href={href(item.href)}
                  aria-current={itemIsCurrent(item.href) ? "page" : undefined}
                  class:list={[
                    "block min-h-11 border-b border-ink px-4 py-3 font-sans text-xs tracking-widest uppercase last:border-b-0 hover:bg-hover",
                    itemIsCurrent(item.href) && "text-accent",
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
