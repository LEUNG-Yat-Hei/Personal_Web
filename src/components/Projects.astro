---
import { site } from "../data";
import { asset } from "../lib/asset";
import SectionHeading from "./SectionHeading.astro";

const heading = site.nav.find((item) => item.id === "projects");
---

<section id="projects" class="scroll-mt-24 newsprint-texture border-b border-ink">
  <div class="mx-auto max-w-screen-xl px-4 py-16">
    <SectionHeading
      title={heading?.label ?? "Projects"}
      deck={heading?.prompt}
    />

    <div class="grid grid-cols-1 border-t border-l border-ink md:grid-cols-2">
      {
        site.projects.map((project, index) => (
          <article class="hard-shadow-hover flex flex-col border-r border-b border-ink bg-paper p-6">
            {project.collaborators?.find((partner) => partner.logo) ? (
              <div class="mb-4 flex h-28 flex-col items-center justify-end border border-ink bg-paper p-3">
                <img
                  src={asset(project.collaborators.find((partner) => partner.logo)?.logo ?? "")}
                  alt=""
                  class="max-h-16 max-w-[6rem] object-contain"
                />
                <span class="mt-2 font-mono text-[11px] tracking-widest uppercase">
                  Fig. 2.{index + 1}
                </span>
              </div>
            ) : (
              <div
                class="mb-4 flex h-28 items-end border border-ink bg-[radial-gradient(#000_1px,transparent_1px)] [background-size:16px_16px] p-3"
                aria-hidden="true"
              >
                <span class="bg-paper px-1 font-mono text-[11px] tracking-widest uppercase">
                  Fig. 2.{index + 1}
                </span>
              </div>
            )}
            <p class="font-mono text-xs tracking-widest text-accent uppercase">
              {project.codename}
            </p>
            <h3 class="mt-2 font-serif text-2xl font-bold text-ink">
              {project.title}
            </h3>
            <p class="mt-2 font-mono text-[11px] tracking-widest text-caption uppercase">
              {project.period.label}
            </p>
            {project.collaborators && project.collaborators.length > 0 && (
              <ul class="mt-3 space-y-1">
                {project.collaborators.map((partner) => (
                  <li class="flex items-center gap-3">
                    {partner.logo && (
                      <span class="flex h-12 w-12 shrink-0 items-center justify-center border border-ink bg-paper p-1">
                        <img
                          src={asset(partner.logo)}
                          alt={`${partner.name} emblem`}
                          class="h-full w-full object-contain"
                        />
                      </span>
                    )}
                    <span class="text-sm">
                      <span class="font-mono text-[11px] tracking-widest text-caption uppercase">
                        {partner.role ?? "In collaboration with"}
                      </span>
                      <span class="mt-0.5 block text-ink">
                        {partner.name}
                        {partner.nameNative && (
                          <span class="text-secondary"> · {partner.nameNative}</span>
                        )}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            )}
            <p class="mt-3 text-justify text-sm leading-relaxed text-secondary">
              {project.summary}
            </p>
            {project.bullets.length > 0 && (
              <ul class="mt-4 flex-1 space-y-2 text-sm leading-relaxed text-ink">
                {project.bullets.map((bullet) => (
                  <li class="text-justify">{bullet}</li>
                ))}
              </ul>
            )}
            <ul class="mt-6 flex flex-wrap gap-2">
              {project.stack.map((item) => (
                <li class="border border-ink px-2 py-1 font-mono text-[11px] tracking-widest uppercase">
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
