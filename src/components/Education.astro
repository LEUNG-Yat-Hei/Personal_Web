---
import { site } from "../data";
import SectionHeading from "./SectionHeading.astro";

const heading = site.nav.find((item) => item.id === "education");
---

<section id="education" class="scroll-mt-24 newsprint-texture border-b border-ink">
  <div class="mx-auto max-w-screen-xl px-4 py-16">
    <SectionHeading
      title={heading?.label ?? "Education"}
      deck={heading?.prompt}
    />

    <div class="grid grid-cols-1 border-t border-l border-ink md:grid-cols-2">
      {
        site.education.map((item) => (
          <article class="border-r border-b border-ink p-6 md:p-8">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-4">
                {item.logo && (
                  <div class="flex h-16 w-16 shrink-0 items-center justify-center border border-ink bg-paper p-1.5">
                    <img
                      src={item.logo}
                      alt={`${item.institutionShort} emblem`}
                      class="h-full w-full object-contain"
                    />
                  </div>
                )}
                <p class="font-mono text-xs tracking-widest uppercase">
                  {item.institutionShort}
                </p>
              </div>
              {item.current && (
                <span class="bg-accent px-2 py-0.5 font-mono text-[10px] tracking-widest text-paper uppercase">
                  Incoming
                </span>
              )}
            </div>
            <h3 class="mt-3 font-serif text-2xl font-bold text-ink lg:text-3xl">
              {item.degree}
            </h3>
            <p class="mt-1 font-serif text-lg italic">{item.field}</p>
            <p class="mt-2 text-sm text-secondary">{item.institution}</p>
            <p class="mt-4 font-mono text-xs tracking-widest text-caption uppercase">
              {item.period.label}
            </p>
            {item.gpa && (
              <p class="mt-3 font-mono text-xs tracking-widest uppercase">
                {item.gpa.label}
              </p>
            )}
            {item.highlights.length > 0 && (
              <ul class="mt-4 space-y-1 text-sm">
                {item.highlights.map((highlight) => (
                  <li>
                    <span class="mr-2 text-accent">†</span>
                    {highlight}
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
